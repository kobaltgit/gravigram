# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ADMIN_ID=123456789

# AI Engine Settings
GEMINI_API_KEY=AIzaSy...
DEFAULT_MODEL=gemini-3.7-flash
# Explicit path to agy binary if not in PATH (optional):
# AGY_BIN_PATH=/usr/local/bin/agy

# Workspace and Server Settings
DEFAULT_WORKSPACE_PATH=.
HOST=0.0.0.0
PORT=8000
CONFIRM_MODE=false

# Mini App Public HTTPS URL (optional: if accessed via domain, Cloudflare Tunnel, ngrok)
# e.g., https://agy.yourdomain.com
WEBAPP_URL=

# Infrastructure Context (optional: extra hints about host environment for the agent)
SYSTEM_CONTEXT_HINT=

# Trusted reverse proxies for API socket connection (optional, comma-separated)
TRUSTED_PROXIES=127.0.0.1,::1

# Google OAuth 2.0 Credentials (optional: for multi-account login in bot)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
